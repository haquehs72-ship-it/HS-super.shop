<!DOCTYPE html>
<html>
<head>


<meta charset='utf-8'>
<meta name='viewport' content='width=device-width, initial-scale=1'>
<title>Web3 Portal</title>
<link href='https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&display=swap' rel='stylesheet'>

</head>
<body>
  <div class='glow-mesh'></div>
  <div class='glow-mesh-2'></div>
  <div class='nav'>
    <div class='logo'>NEXUS.ETH</div>
    <div class='right-nav'>
      <div class='net-badge' id='networkBadge' onclick='switchNet()'>Ethereum</div>
      <button class='wallet-btn' id='walletBtn' onclick='connectWallet()'>Connect Wallet</button>
    </div>
  </div>
  <div class='hero'>
    <h1>Decentralize <span>Everything</span></h1>
    <p class='desc'>Earn rewards, track crypto trends, and build on the most secure decentralized portal of the future.</p>
    <button class='btn-gradient' onclick='launchPortal()'>Launch Portal 🚀</button>
  </div>
  

</body><!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>সুপার শপ</title>

</head>
<body>

<div class="topbar"><span>📞 হটলাইন: 01700-000000</span><span>🚚 ৫০০ টাকার উপরে ফ্রি ডেলিভারি</span></div>

<header>
  <div class="logo">🛒 সুপার শপ</div>
  <div class="search">
    <input type="text" placeholder="পণ্য খুঁজুন... (চাল, ডাল, তেল)">
    <button>খুঁজুন</button>
  </div>
  <div class="cart">🛍️ কার্ট <b id="count">0</b></div>
</header>

<div class="container">

  <div class="top">
    <div class="sidebar">
      <a href="#">🍚 চাল ও ডাল</a>
      <a href="#">🥬 শাকসবজি</a>
      <a href="#">🐟 মাছ ও মাংস</a>
      <a href="#">🛢️ তেল ও মসলা</a>
      <a href="#">🥛 দুধ ও ডিম</a>
      <a href="#">🍪 স্ন্যাকস</a>
      <a href="#">🧼 সাবান ও ক্লিনিং</a>
      <a href="#">👶 বেবি কেয়ার</a>
    </div>
    <div class="slider">
      <div class="slide s1 active"><h2>মেগা সুপার সেল!</h2><p>নিত্যপণ্যে ২০% পর্যন্ত ছাড়</p><a class="go" href="#flash">এখনই কিনুন</a></div>
      <div class="slide s2"><h2>তাজা শাকসবজি</h2><p>সরাসরি খামার থেকে আপনার ঘরে</p><a class="go" href="#products">অর্ডার করুন</a></div>
      <div class="slide s3"><h2>ক্যাশ অন ডেলিভারি</h2><p>পণ্য হাতে পেয়ে টাকা দিন</p><a class="go" href="#products">শুরু করুন</a></div>
      <div class="dots"><span class="on"></span><span></span><span></span></div>
    </div>
  </div>

  <div class="box">
    <h3>ক্যাটাগরি</h3>
    <div class="cats">
      <div class="cat"><span>🍚</span>চাল ও ডাল</div>
      <div class="cat"><span>🥬</span>শাকসবজি</div>
      <div class="cat"><span>🐟</span>মাছ ও মাংস</div>
      <div class="cat"><span>🛢️</span>তেল ও মসলা</div>
      <div class="cat"><span>🥛</span>দুধ ও ডিম</div>
      <div class="cat"><span>🧼</span>সাবান</div>
    </div>
  </div>

  <div class="box" id="flash">
    <div class="flash-head">
      <h3>⚡ ফ্ল্যাশ সেল</h3>
      <div class="timer">শেষ হবে: <span id="time">05:00:00</span></div>
    </div>
    <div class="products">
      <div class="card"><div class="off">-১৫%</div><div class="img">🍚</div><div class="name">মিনিকেট চাল</div><div class="unit">৫ কেজি</div><div class="price">৪২০ ৳ <span class="old">৪৯৫ ৳</span></div><button onclick="addCart()">কার্টে যোগ করুন</button></div>
      <div class="card"><div class="off">-১০%</div><div class="img">🛢️</div><div class="name">সয়াবিন তেল</div><div class="unit">৫ লিটার</div><div class="price">৮৩০ ৳ <span class="old">৯২০ ৳</span></div><button onclick="addCart()">কার্টে যোগ করুন</button></div>
      <div class="card"><div class="off">-২০%</div><div class="img">🧅</div><div class="name">দেশি পেঁয়াজ</div><div class="unit">১ কেজি</div><div class="price">৮৪ ৳ <span class="old">১০৫ ৳</span></div><button onclick="addCart()">কার্টে যোগ করুন</button></div>
      <div class="card"><div class="off">-১২%</div><div class="img">🫘</div><div class="name">মসুর ডাল</div><div class="unit">১ কেজি</div><div class="price">১১৮ ৳ <span class="old">১৩৫ ৳</span></div><button onclick="addCart()">কার্টে যোগ করুন</button></div>
    </div>
  </div>

  <div class="box" id="products">
    <h3>আপনার জন্য সেরা পণ্য</h3>
    <div class="products">
      <div class="card"><div class="img">🥚</div><div class="name">ফার্মের ডিম</div><div class="unit">১২ পিস</div><div class="stars">★★★★☆</div><div class="price">১৪৫ ৳</div><button onclick="addCart()">কার্টে যোগ করুন</button></div>
      <div class="card"><div class="img">🥛</div><div class="name">তরল দুধ</div><div class="unit">১ লিটার</div><div class="stars">★★★★★</div><div class="price">৯০ ৳</div><button onclick="addCart()">কার্টে যোগ করুন</button></div>
      <div class="card"><div class="img">🥔</div><div class="name">আলু</div><div class="unit">১ কেজি</div><div class="stars">★★★★☆</div><div class="price">৪৫ ৳</div><button onclick="addCart()">কার্টে যোগ করুন</button></div>
      <div class="card"><div class="img">🍅</div><div class="name">টমেটো</div><div class="unit">১ কেজি</div><div class="stars">★★★★☆</div><div class="price">৭০ ৳</div><button onclick="addCart()">কার্টে যোগ করুন</button></div>
      <div class="card"><div class="img">🐟</div><div class="name">রুই মাছ</div><div class="unit">১ কেজি</div><div class="stars">★★★★★</div><div class="price">৩৮০ ৳</div><button onclick="addCart()">কার্টে যোগ করুন</button></div>
      <div class="card"><div class="img">🍌</div><div class="name">কলা (সাগর)</div><div class="unit">১২ পিস</div><div class="stars">★★★★☆</div><div class="price">৮০ ৳</div><button onclick="addCart()">কার্টে যোগ করুন</button></div>
      <div class="card"><div class="img">🧼</div><div class="name">লন্ড্রি সাবান</div><div class="unit">৫০০ গ্রাম</div><div class="stars">★★★★☆</div><div class="price">৬৫ ৳</div><button onclick="addCart()">কার্টে যোগ করুন</button></div>
      <div class="card"><div class="img">🍪</div><div class="name">বিস্কুট</div><div class="unit">৫ প্যাকেট</div><div class="stars">★★★★☆</div><div class="price">১০০ ৳</div><button onclick="addCart()">কার্টে যোগ করুন</button></div>
    </div>
  </div>

  <div class="features">
    <div class="feature"><span>🚚</span>দ্রুত ডেলিভারি</div>
    <div class="feature"><span>💵</span>ক্যাশ অন ডেলিভারি</div>
    <div class="feature"><span>✅</span>১০০% তাজা পণ্য</div>
    <div class="feature"><span>🔄</span>সহজ রিটার্ন</div>
  </div>

</div>

<footer>
  <p>© ২০২৬ সুপার শপ | সব অধিকার সংরক্ষিত</p>
  <p>হটলাইন: 01700-000000 | ঢাকা, বাংলাদেশ</p>
</footer>



</body>
</html>
</html>
